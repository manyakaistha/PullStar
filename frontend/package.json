{
  "name": "pullstar",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js tests/*.test.cjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "desktop": "concurrently -k \"npm run dev\" \"npm run electron\"",
    "package:mac": "npm run build && electron-builder --mac dmg --arm64 --config electron-builder.yml"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.18.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.3.5",
    "wait-on": "^9.1.0"
  },
  "description": "Align the night. Keep the motion.",
  "author": "Manya Kaistha",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/manyakaistha/PullStar.git"
  }
}
